[Unit]
Description=Shiyi private pilot
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/tryon
EnvironmentFile=/etc/tryon/tryon.env
Environment=SHIYI_DATA_DIR=/var/lib/tryon
ExecStart=/opt/tryon/.venv/bin/python local/server.py --port 8765
Restart=on-failure
RestartSec=5
MemoryMax=220M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
